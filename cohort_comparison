FUSCC <- read.csv("....csv")
clinical_FUSCC <- read.csv("....csv")
clinical_FUSCC <- clinical_FUSCC[,c(1,6,7)]
clinical_FUSCC_early <- clinical_FUSCC[-which(clinical_FUSCC$Sample_Group == "Advanced" ),]
FUSCC_maf_early <- merge(FUSCC,clinical_FUSCC_early,by = "Tumor_Sample_Barcode")
TCGA_maf_early <- read.maf(TCGA_maf_early)
FUSCC_maf_early <- read.maf(FUSCC_maf_early)
{
  m1Name = "FUSCC_Mutated_Sample"
  m2Name = "TCGA_Mutated_Sample"
  m1NameN = "FUSCC_Nonmutated_Sample"
  m2NameN = "TCGA_Nonmutated_Sample"
  P.Vals = "P.Vals"
  Direction = "Direction" 
  FDR= "FDR"
  m1 = FUSCC_maf_early
  m2 = TCGA_maf_early
  m1.gs <- getGeneSummary(x = m1)
  m2.gs <- getGeneSummary(x = m2)
  minMut = 0
  m1.genes = as.character(m1.gs[MutatedSamples >= minMut, Hugo_Symbol])
  m2.genes = as.character(m2.gs[MutatedSamples >= minMut, Hugo_Symbol])
  overlapGenes = read.table("....csv", header = TRUE , sep = ",")
  overlapGenes = overlapGenes$Gene
  m1.sampleSize = as.numeric(m1@summary[3, summary])
  m2.sampleSize = as.numeric(m2@summary[3, summary])
  m1.gs.comGenes = m1.gs[Hugo_Symbol %in% overlapGenes]
  m2.gs.comGenes = m2.gs[Hugo_Symbol %in% overlapGenes]  
  sampleSummary = data.table::data.table(Cohort = c(m1Name, m2Name), SampleSize = c(m1.sampleSize, m2.sampleSize))
  m.gs.meged = merge(m1.gs.comGenes[, .(Hugo_Symbol, MutatedSamples)], 
                     m2.gs.comGenes[, .(Hugo_Symbol, MutatedSamples)], 
                     by = "Hugo_Symbol", all = TRUE)
  m.gs.meged[is.na(m.gs.meged)] = 0
  m.gs.meged = as.data.frame(m.gs.meged)
  fisherTable = c()
  for (i in 1:nrow(m.gs.meged)) {
    gene = m.gs.meged[i, 1]
    m1Mut = m.gs.meged[i, 2]
    m2Mut = m.gs.meged[i, 3]
    m1nonMut = m1.sampleSize - m1Mut
    m2nonMut = m2.sampleSize - m2Mut
    m1fraction = m1Mut/m1.sampleSize
    m2fraction = m2Mut/m2.sampleSize
    xf = fisher.test(matrix(c(m1Mut, m1.sampleSize - m1Mut, m2Mut, m2.sampleSize - m2Mut), byrow = TRUE, nrow = 2), conf.int = TRUE, conf.level = 0.95)
    pval = xf$p.value
    or = xf$estimate
    Direction = ifelse(xf$estimate > 1, -1, 1)
    ci.up = xf$conf.int[1]
    ci.low = xf$conf.int[2]
    tdat = data.table::data.table(Hugo_Symbol = gene, m1Mut, m2Mut, m1nonMut, m2nonMut, m1fraction, m2fraction, pval = pval, Direction = Direction)
    fisherTable = rbind(fisherTable, tdat)
  }
  fisherTable = fisherTable[order(pval)]
  fisherTable[, `:=`(adjPval, p.adjust(p = pval, method = "bonferroni"))]
  colnames(fisherTable)[1:10] = c("Gene_symbol", m1Name, m2Name, m1NameN, m2NameN, "FUSCC_Mutated_Fraction_early", "TCGA_Mutated_Fraction_early", "P.Vals", "Direction", "FDR")
  FUSCC_TCGA_Mutation_Compare <- fisherTable
  FUSCC_TCGA_Mutation_Compare$FDR_1 <- as.factor(ifelse(FUSCC_TCGA_Mutation_Compare$FDR< 0.05,'FDR < 0.05', 'FDR >= 0.05'))
  FDR_cutoff = as.numeric(fisherTable[10,10])
  
  
  highlight_genes <- FUSCC_TCGA_Mutation_Compare %>%
    filter(Gene_symbol %in% c("PIK3CA"))
  FDR_genes <- FUSCC_TCGA_Mutation_Compare %>%
    filter(Gene_symbol %in% c("CDH1","PIK3CA","KMT2D","PKD1","KIF26B","TP53","ATN1")) 
    ggplot(data = FUSCC_TCGA_Mutation_Compare, mapping = aes(x = FUSCC_Mutated_Fraction_early, y = TCGA_Mutated_Fraction_early, color=FDR_1 ))+ 
    geom_point(size = 3) + theme_bw() + xlim(c(0, 0.9)) + ylim(c(0, 0.9)) + 
    geom_abline(intercept=0,slope=1, linetype="dashed", size = 0.8, color = '#747475') +
    scale_color_manual(values =c("#E41A1C","#B3B3B3")) + 
    theme(panel.grid.major = element_blank(), 
          panel.grid.minor = element_blank(),   
          axis.line = element_line(colour = "black")) + 
    
    geom_point(data = highlight_genes, aes(x = FUSCC_Mutated_Fraction_early, y = TCGA_Mutated_Fraction_early), 
               color = "#E41A1C", size = 2.5, shape = 21, fill = "#E41A1C") +  
    geom_text(data = FDR_genes, aes(label = Gene_symbol), 
  vjust = -1, color = "black", size = 2.5) 
}  
